# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Vendored third-party (re-fetch: see docs/SETUP.md + reports; never edit)
third_party/

# OS/editor
.DS_Store
*~

# Large generated artifacts (regenerable; kept on disk, not in git)
checkpoints/**/*.pt
data/datasets/

# Scratch
/tmp/
*.log

# Agent/harness session state + MuJoCo runtime logs (never commit)
.omo/
MUJOCO_LOG.TXT

# Operator reference media + credentials (copyright + live session tokens: never commit)
data/references/**/*.mp4
data/references/**/*.webm
data/references/**/*.mkv
data/references/**/*.info.json
data/references/cookies*.txt

# Videos that embed third-party source footage (derived overlays stay local; G1-side clips commit)
videos/refs_video/*overlay*.mp4

# Large regenerable reference dumps (small JSON specs + retargeted transitions DO commit)
data/references/**/*.npz
data/references/**/derived/analysis/*.png
data/locks/
