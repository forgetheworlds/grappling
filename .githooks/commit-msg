#!/bin/bash
msg_file="$1"
sed -i -E '/^(co-authored-by|generated-by|assisted-by|reviewed-by|generated with)[[:space:]:]*/Id' "$msg_file"
if grep -qiE '(anthropic|openai|cursor\.com|claude\.ai|chatgpt|copilot|generated with[[:space:]]+(claude|gpt|ai))' "$msg_file"; then
  echo "BLOCKED: third-party attribution in commit message."
  exit 1
fi
exit 0
